<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Activity Tracker"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- Current Session -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CURRENT SESSION"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvSteps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Steps: 0"
            android:textSize="24sp"
            android:padding="8dp" />

        <TextView
            android:id="@+id/tvShakes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Shakes: 0"
            android:textSize="24sp"
            android:padding="8dp" />

        <TextView
            android:id="@+id/tvDuration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Duration: 00:00"
            android:textSize="18sp"
            android:padding="8dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#CCCCCC"
            android:layout_marginVertical="16dp" />

        <!-- Average Statistics -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AVERAGE STATISTICS"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvStepsPerMinute"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Steps/min: 0"
            android:textSize="18sp"
            android:padding="8dp" />

        <TextView
            android:id="@+id/tvShakesPerMinute"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Shakes/min: 0"
            android:textSize="18sp"
            android:padding="8dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#CCCCCC"
            android:layout_marginVertical="16dp" />

        <!-- Session Controls -->

        <Button
            android:id="@+id/btnStartSession"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Start Session" />

        <Button
            android:id="@+id/btnStopSession"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Stop Session"
            android:layout_marginTop="8dp" />

    </LinearLayout>

</ScrollView>
